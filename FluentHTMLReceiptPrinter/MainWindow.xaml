<ui:FluentWindow x:Class="FluentHTMLReceiptPrinter.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 mc:Ignorable="d"
                 Title="Fluent HTML Receipt Printer"
                 Height="580"
                 Width="1000"
                 MinHeight="480"
                 MinWidth="860">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Fluent HTML Receipt Printer" Height="36" />

        <Menu Grid.Row="1" Background="White" BorderThickness="0,0,0,1" BorderBrush="#E0E0E0" Padding="4,2">
            <MenuItem Header="File">
                <MenuItem Header="Save Input" InputGestureText="Ctrl+S" Click="SaveInput_Click" />
                <MenuItem Header="Clear Input" Click="ClearInput_Click" />
                <Separator />
                <MenuItem Header="Exit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="Edit">
                <MenuItem Header="Select All" Click="SelectAll_Click" />
                <MenuItem Header="Copy" Click="Copy_Click" />
                <MenuItem Header="Paste" Click="Paste_Click" />
                <Separator />
                <MenuItem Header="Clear" Click="ClearInput_Click" />
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="About" Click="About_Click" />
            </MenuItem>
        </Menu>

        <Grid Grid.Row="2" Margin="12,8,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" VerticalAlignment="Stretch" Margin="12">
                <Grid VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="0,0,0,8" Text="Input" FontWeight="SemiBold" />
                    <ui:TextBox Grid.Row="1"
                                VerticalAlignment="Stretch"
                                HorizontalAlignment="Stretch"
                                MinHeight="260"
                                x:Name="InputHtmlTextBox"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Auto"
                                PlaceholderText="Paste or type receipt HTML here..." />
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="2"
                          Margin="8,0"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Center"
                          Background="#E0E0E0"
                          MouseEnter="GridSplitter_MouseEnter"
                          MouseLeave="GridSplitter_MouseLeave"
                          Cursor="SizeWE" />

            <Grid Grid.Column="2" VerticalAlignment="Stretch" Margin="12">
                <Grid VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="0,0,0,8" Text="Preview Output" FontWeight="SemiBold" />
                    <FlowDocumentScrollViewer Grid.Row="1"
                                              x:Name="OutputPreviewViewer"
                                              VerticalAlignment="Stretch"
                                              HorizontalAlignment="Stretch"
                                              IsToolBarVisible="False"
                                              HorizontalScrollBarVisibility="Disabled"
                                              MinHeight="260" />
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Margin="12,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="Printer:" />
                <ComboBox Grid.Row="0" Grid.Column="1" MinWidth="240" MaxWidth="400" x:Name="PrintersComboBox"
                          VerticalAlignment="Center" />

                <Rectangle Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" Width="1" Height="24" Margin="16,0"
                           Fill="#E0E0E0" VerticalAlignment="Center" />

                <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Chars/Line:" />
                    <ui:NumberBox x:Name="CharsPerLineBox"
                                  MinWidth="70"
                                  Value="42"
                                  Minimum="20"
                                  Maximum="100"
                                  ClearButtonEnabled="False"
                                  VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="3"
                           Text="42 ≈ 80mm paper width"
                           FontSize="12"
                           Opacity="0.55"
                           Margin="0,2,0,0" />
            </Grid>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Margin="0,0,8,0" Content="Preview" Icon="{ui:SymbolIcon Eye24}" Click="PreviewButton_Click" />
                <ui:Button x:Name="PrintButton" Content="Print" Appearance="Primary" Icon="{ui:SymbolIcon Print24}"
                           Click="PrintButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>